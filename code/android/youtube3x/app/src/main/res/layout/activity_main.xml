<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/browser_content"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">
        <HorizontalScrollView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fillViewport="true" android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingHorizontal="8dp" android:paddingVertical="4dp"
            android:gravity="center_vertical" android:orientation="horizontal">
            <ImageButton android:id="@+id/home" style="@style/ToolbarIcon"
                android:src="@drawable/ic_home" android:contentDescription="@string/home"
                android:tooltipText="@string/home" />
            <ImageButton android:id="@+id/back" style="@style/ToolbarIcon"
                android:src="@drawable/ic_back" android:contentDescription="@string/back"
                android:tooltipText="@string/back" />
            <ImageButton android:id="@+id/forward" style="@style/ToolbarIcon"
                android:src="@drawable/ic_forward" android:contentDescription="@string/forward"
                android:tooltipText="@string/forward" />
            <ImageButton android:id="@+id/reload" style="@style/ToolbarIcon"
                android:src="@drawable/ic_reload" android:contentDescription="@string/reload"
                android:tooltipText="@string/reload" />
            <Space android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
            <ImageButton android:id="@+id/video_fullscreen" style="@style/ToolbarIcon"
                android:src="@drawable/ic_fullscreen" android:contentDescription="@string/video_fullscreen"
                android:tooltipText="@string/video_fullscreen" />
            <ImageButton android:id="@+id/ad_block" style="@style/ToolbarIcon"
                android:layout_marginEnd="4dp" android:background="@drawable/control_background"
                android:src="@drawable/ic_shield" android:contentDescription="@string/ad_block_on"
                android:tooltipText="@string/ad_block_on" />
            <Button android:id="@+id/normal_speed" style="@style/ToolbarChip"
                android:layout_width="48dp" android:text="@string/normal_speed"
                android:contentDescription="@string/normal_speed_description" />
            <Button android:id="@+id/triple_speed" style="@style/ToolbarChip"
                android:layout_width="48dp" android:layout_marginStart="4dp"
                android:text="@string/triple_speed"
                android:contentDescription="@string/triple_speed_description" />
        </LinearLayout>
        </HorizontalScrollView>
        <LinearLayout
            android:id="@+id/address_bar"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/search_background"
            android:gravity="center_vertical" android:orientation="horizontal">
            <EditText android:id="@+id/address" android:layout_width="0dp"
                android:layout_height="48dp" android:layout_weight="1"
                android:hint="@string/address_hint" android:inputType="text"
                android:importantForAutofill="no"
                android:imeOptions="actionGo" android:maxLines="1" android:singleLine="true"
                android:background="@null" android:textColor="#F4F4F5" android:textColorHint="#A4A4AF"
                android:paddingStart="14dp" android:paddingEnd="4dp" android:textSize="14sp" />
            <ImageButton android:id="@+id/go" style="@style/ToolbarIcon"
                android:src="@drawable/ic_forward" android:contentDescription="@string/go"
                android:tooltipText="@string/go" />
        </LinearLayout>
        <TextView android:id="@+id/status" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:paddingHorizontal="12dp"
            android:paddingBottom="8dp" android:visibility="gone"
            android:textColor="#A4A4AF" android:textSize="12sp"
            android:accessibilityLiveRegion="polite" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" />
        <WebView android:id="@+id/web_view" android:layout_width="match_parent"
            android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>
    <FrameLayout android:id="@+id/fullscreen_container"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#000000" android:visibility="gone" />
</FrameLayout>
